  "item": [
    {
      "name": "{{base_url}}/token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Test: HTTP 200\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Test: Response contains accessToken\npm.test(\"Response contains accessToken\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property(\"accessToken\");\n    pm.expect(jsonData.accessToken).to.be.a(\"string\").and.to.have.length.above(0);\n});\n\n// Test: tokenType is Bearer\npm.test(\"tokenType is Bearer\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");\n});\n\n// Test: expiryDateTime is a valid ISO date string and is in the future\npm.test(\"expiryDateTime is a valid ISO date string and is in the future\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property(\"expiryDateTime\");\n    var expiry = new Date(jsonData.expiryDateTime);\n    pm.expect(isNaN(expiry.getTime())).to.be.false; // valid date\n    pm.expect(expiry.getTime()).to.be.above(Date.now()); // in the future\n});\n\n// Save access_token to environment\nvar jsonData = pm.response.json();\nif (pm.response.code === 200 && jsonData.accessToken) {\n    pm.environment.set(\"access_token\", jsonData.accessToken);\n    console.log(\"access_token saved to environment\");\n}"
            ]
          }
        }
      ],
